# Genei AI — environment template
#
# Copy to `.env` and fill in what your deployment needs. Nothing here is required for the
# application to start: every value below has a working default or a documented degraded
# mode. The application is designed to run fully local with this file empty.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Port the server listens on. Default 3000.
PORT=3000

# "production" serves the built client from dist/public; "development" uses Vite.
NODE_ENV=production

# ---------------------------------------------------------------------------
# Database (optional)
# ---------------------------------------------------------------------------

# MySQL connection string. Without it the app runs, but anything that persists to the
# database — projects, jobs, saved assets, accounts — is unavailable rather than
# silently faked. There is no in-memory substitute.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication (optional)
# ---------------------------------------------------------------------------

# Hosted OAuth. Without it the hosted sign-in routes are unavailable and the application
# logs a warning (not an error) at startup. Local-first sign-in is unaffected.
OAUTH_SERVER_URL=

# ---------------------------------------------------------------------------
# Local AI runtime (optional)
# ---------------------------------------------------------------------------

# Where the execution plane listens. Set this to run real generation on this machine.
# Without it, the pipeline reports exactly which tool is missing rather than fabricating.
GENEI_RUNTIME_URL=
GENEI_RUNTIME_TOKEN=

# Paths to local tool binaries, if they are not on PATH.
GENEI_FFMPEG_BIN=
GENEI_LLAMA_BIN=
GENEI_LLAMA_MODEL=

# ---------------------------------------------------------------------------
# Runner (optional)
# ---------------------------------------------------------------------------

# A paired BYOH workstation reports through an outbound heartbeat. It never receives
# provider keys.
GENEI_SERVER_URL=
GENEI_RUNNER_TOKEN=
GENEI_HEARTBEAT_SECONDS=30

# ---------------------------------------------------------------------------
# Outbound network
# ---------------------------------------------------------------------------

# Set to 1 to disable the environment proxy dispatcher. Localhost is always bypassed.
GENEI_DISABLE_PROXY=

# ---------------------------------------------------------------------------
# Signing (optional — release builds only)
# ---------------------------------------------------------------------------

# Base64 of a Windows code-signing certificate. Without it, releases are unsigned and
# Windows shows a SmartScreen warning. A self-signed certificate only removes the warning
# on machines that already trust it.
WINDOWS_SIGNING_CERT_BASE64=
WINDOWS_SIGNING_CERT_PASSWORD=
