  "lessons": [
    {
      "at": "2026-10-19T06:45:27+00:00",
      "capability": "",
      "capability_version": "",
      "lesson": "The registry defaults to ./capability-registry.json relative to the working directory, and the skill sandbox directory is recreated from the package every session. A registry populated there does not survive, so the weekly review can never accumulate history. Always pass --registry with a durable path.",
      "source": "observed: audit log genesis record seq=0 after a fresh skill materialisation",
      "status": "verified",
      "topic": "registry-persistence"
    },
    {
      "at": "2026-10-19T06:45:27+00:00",
      "capability": "",
      "capability_version": "",
      "lesson": "pnpm audit --prod on genei-ai reports 93 advisories across 601 production dependencies: 3 critical, 23 high, 55 moderate, 12 low. Six affected packages are direct dependencies (axios, drizzle-orm, mysql2, nanoid, @trpc/server, @capacitor/android); the rest are transitive. Only dompurify has no patched version available.",
      "source": "pnpm audit --prod --json, 2026-10-19",
      "status": "verified",
      "topic": "dependency-advisories"
    },
    {
      "at": "2026-10-19T07:12:07+00:00",
      "capability": "",
      "capability_version": "",
      "lesson": "The registry now lives at capabilities/registry.json inside the repository, which is the only location that survives a session, a package reset and a sandbox recycle. Every command must pass --registry explicitly, or it writes to a path that is discarded.",
      "source": "verified: the registry persisted across the re-materialisation of the skill directory and its audit chain is intact",
      "status": "verified",
      "topic": "registry-durability"
    },
    {
      "at": "2026-10-19T07:12:08+00:00",
      "capability": "",
      "capability_version": "",
      "lesson": "93 production advisories were reduced to 0 by raising six direct dependencies to their lowest patched version within the existing major range, and pinning eleven transitive packages with pnpm overrides to the lowest patched version in the same major line. drizzle-orm 0.44.6 -> 0.45.4 left its range deliberately and was validated by a new test asserting every table keeps its name, columns and primary key, that SQL stays parameterised, and that migrations remain in parity. No major versions were jumped and no advisories were suppressed.",
      "source": "pnpm audit --prod before and after, plus tsc, 469 vitest, 60 pytest and a clean production build",
      "status": "verified",
      "topic": "dependency-remediation"
    },
    {
      "at": "2026-10-19T07:12:08+00:00",
      "capability": "",
      "capability_version": "",
      "lesson": "A focusable-element filter that checks offsetParent is wrong: it is null for every position:fixed element, so it excludes exactly the elements inside a fixed modal that the focus trap exists to find. Filter on hidden and disabled instead.",
      "source": "found by a failing jsdom test in round 19; fixed and covered by a test",
      "status": "verified",
      "topic": "focusable-offsetparent"
    }
  ],
  "updated": "2026-10-19T07:12:08+00:00",
